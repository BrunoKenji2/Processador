// main:
// 0x00 (0): addi $sp, $zero, 60
00000100000111010000000000111100
// 0x04 (1): addi $a0, $zero, 3
00000100000001000000000000000011
// 0x08 (2): jal factorial (salta para palavra 5 / endereço 0x14)
00110000000000000000000000000101
// 0x0C (3): PRINT $v0
00101000010000000000000000000000
// 0x10 (4): j 0x10 (loop infinito, salta para palavra 4)
00011100000000000000000000000100

// factorial: (Início na palavra 5 / endereço 0x14)
// 0x14 (5): addi $sp, $sp, -8
00000111101111011111111111111000
// 0x18 (6): sw $ra, 4($sp)
00010011101111110000000000000100
// 0x1C (7): sw $a0, 0($sp)
00010011101001000000000000000000
// 0x20 (8): addi $at, $zero, 2       // $at = 2 (para slt)
00000100000000010000000000000010
// 0x24 (9): slt $t0, $a0, $at        // $t0 = ($a0 < $at) ? 1 : 0
00000000100000010100000000101010
// 0x28 (10): beq $t0, $zero, recursive_step (se $t0=0 ($a0>=2), salta para palavra 13 / 0x34. Offset = 2 palavras)
00010101000000000000000000000010
// Base case (n < 2):
// 0x2C (11): addi $v0, $zero, 1
00000100000000100000000000000001
// 0x30 (12): j factorial_epilogue (salta para palavra 17 / 0x44)
0001110000000000000000000010001

// recursive_step: (Início na palavra 13 / endereço 0x34)
// 0x34 (13): addi $a0, $a0, -1
00000100100001001111111111111111
// 0x38 (14): jal factorial (salta para palavra 5 / 0x14)
00110000000000000000000000000101
// 0x3C (15): lw $a0, 0($sp)
00001111101001000000000000000000
// 0x40 (16): mult $a0, $v0
00000000100000100000000000011000

// factorial_epilogue: (Início na palavra 17 / endereço 0x44)
// 0x44 (17): mflo $v0
00000000000000000001000000010010
// 0x48 (18): lw $ra, 4($sp)
00001111101111110000000000000100
// 0x4C (19): addi $sp, $sp, 8
00000111101111010000000000001000
// 0x50 (20): jr $ra
00100111111000000000000000000000